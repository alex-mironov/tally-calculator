// tally-share — Tally Calculator's web half: the marketing site, the share
// pages (/s/:id) and the share API the iOS app talks to.
//
// Keeps the worker name and KV namespace of the Hono worker it replaced, so
// the workers.dev origin baked into shipped app builds — and every share link
// already in the wild — keeps resolving.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tally-share",
  // pinned so CI only needs CLOUDFLARE_API_TOKEN (not an account-id secret too)
  "account_id": "eaab5d556c5870452c9eadc9ffa99506",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "kv_namespaces": [
    {
      "binding": "SHARES",
      "id": "6cec2f97914a474090859f212264e7ec"
    }
  ]
}
